# ===== Configuración ContigoAI =====

# --- LLM: elegir UNO ---

# Opción A: Groq (recomendado, capa gratuita). Crear key en https://console.groq.com
#   Modelos gratis frecuentes: openai/gpt-oss-120b, qwen/qwen3.8-27b (ver /models)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Opción B: Ollama local (gratis, sin key). Instalar desde https://ollama.com
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Opción C: OpenAI compatible (cualquier proveedor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Proveedor por defecto: groq | ollama | openai ---
LLM_PROVIDER=groq

# --- RAG ---
# Dimensión de embeddings (no editar)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- EP3: observabilidad ---
# Sin token: dashboard y memoria accesibles solo desde 127.0.0.1 / ::1.
# Para restringir también el acceso local, define una clave larga y privada.
CONTIGOAI_OBS_TOKEN=
CONTIGOAI_OBS_RETENCION_DIAS=30
# CONTIGOAI_OBS_DB=datos/observabilidad/metricas.db

# Opcional: RAG local sin descargar modelos. Requiere ejecutar ingesta otra vez.
# CONTIGOAI_EMBEDDINGS=tfidf
# CONTIGOAI_INDICE_DIR=datos/.indice_tfidf
