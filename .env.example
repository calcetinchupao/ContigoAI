# ===== Configuración ContigoAI =====

# --- LLM: elegir UNO ---

# Opción A: Groq (recomendado, capa gratuita). Crear key en https://console.groq.com
#   Modelo: llama-3.1-8b-instant (rápido y gratuito) o llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Opción B: Ollama local (gratis, sin key). Instalar desde https://ollama.com
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Opción C: OpenAI compatible (cualquier proveedor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Proveedor por defecto: groq | ollama | openai ---
LLM_PROVIDER=groq

# --- RAG ---
# Dimensión de embeddings (no editar)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2